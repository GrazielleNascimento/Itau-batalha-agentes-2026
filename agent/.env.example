# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Modo local (default): uma chave do AI Studio, sem projeto GCP, sem ADC,
# sem APIs habilitadas e sem billing. Pegue em https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=

# Modo nuvem: comente as duas linhas acima e descomente as três abaixo.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- Núcleo local ---
MODEL_NAME=gemini-3.8-flash
PROMPT_VERSION=v1
DATA_SOURCE=local
DATA_DIR=../data
DEMO_MODE=true
DEMO_CUSTOMER_ID=FICT-0001
MEMORY_TTL_DAYS=90
GUARD_STRIKES_TO_HUMAN=3
# Model Armor: camada gerenciada de injection/jailbreak, ADICIONAL ao guard local.
# ATENÇÃO: não existe em southamerica-east1. Ligar faz o texto sair do Brasil —
# já mascarado, porque o mascaramento de PII roda antes.
USE_MODEL_ARMOR=false
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=batalha-agentes-guard
USE_RAG_ENGINE=false
# REGION = onde o Cloud Run roda. GOOGLE_CLOUD_LOCATION = onde o modelo roda.
REGION=southamerica-east1
